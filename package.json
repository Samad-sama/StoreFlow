{
  "name": "storeflow",
  "version": "1.0.0",
  "description": "Universal Store & POS Management System",
  "author": "StoreFlow Team <support@storeflow.app>",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:dev": "cross-env NODE_ENV=development electron . --dev",
    "desktop:build": "npm run build && electron-builder --win",
    "build:win": "npm run build && electron-builder --win portable --x64",
    "build:win:nsis": "npm run build && electron-builder --win nsis --x64",
    "build:win:zip": "npm run build && electron-builder --win zip --x64",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@tanstack/react-query": "^5.18.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "dexie": "^4.0.4",
    "dexie-react-hooks": "^1.1.7",
    "framer-motion": "^11.0.0",
    "i18next": "^23.8.2",
    "lucide-react": "^0.378.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-hook-form": "^7.53.1",
    "react-i18next": "^14.1.0",
    "react-router-dom": "^6.22.0",
    "recharts": "^2.12.3",
    "tailwind-merge": "^2.3.0",
    "zod": "^3.23.8",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "jsdom": "^24.0.0",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.4",
    "vite": "^5.4.1",
    "vitest": "^1.4.0",
    "wait-on": "^9.5.1"
  }
}
